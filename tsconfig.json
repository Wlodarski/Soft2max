{
  "compilerOptions": {
    /* Choix de l'environnement et des modules */
    "target": "ES2022",                          /* Version ECMAScript cible pour le JavaScript généré */
    "module": "NodeNext",                        /* Standard de modules moderne adapté pour Node.js (ESM) */
    "moduleResolution": "NodeNext",              /* Stratégie de résolution des dépendances alignée sur NodeNext */

    /* Génération des fichiers pour la distribution */
    "declaration": true,                         /* Génère automatiquement les fichiers .d.ts associés */
    "outDir": "./dist",                          /* Répertoire de destination pour les fichiers compilés */
    "rootDir": "./src",                          /* Répertoire source contenant votre logique métier */

    /* Vérifications strictes du compilateur */
    "strict": true,                              /* Active l'ensemble des vérifications de types strictes */
    "noImplicitAny": true,                       /* Interdit les expressions et déclarations avec un type 'any' implicite */
    "strictNullChecks": true,                    /* Prend en compte explicitement 'null' et 'undefined' dans le typage */
    "strictFunctionTypes": true,                 /* Vérification rigoureuse des signatures de fonctions */
    "noImplicitThis": true,                      /* Lève une erreur si la valeur de 'this' est de type 'any' implicite */
    "alwaysStrict": true,                        /* Analyse chaque fichier en mode strict JS et émet 'use strict' */

    /* Analyses additionnelles de qualité de code */
    "noUnusedLocals": true,                      /* Rapporte les erreurs sur les variables locales inutilisées */
    "noUnusedParameters": true,                  /* Rapporte les erreurs sur les paramètres de fonctions inutilisés */
    "noImplicitReturns": true,                   /* Garantit que toutes les branches de code d'une fonction retournent une valeur */
    "noFallthroughCasesInSwitch": true,           /* Interdit les chutes de cas non vides dans les blocs switch */

    /* Paramètres d'interopérabilité et système */
    "esModuleInterop": true,                     /* Facilite l'importation de modules CommonJS traditionnels */
    "skipLibCheck": true,                        /* Accélère la compilation en ignorant la vérification des fichiers .d.ts externes */
    "forceConsistentCasingInFileNames": true     /* Évite les problèmes de compilation entre systèmes d'exploitation (Mac/Linux/Windows) */
  },
  "include": [
    "src/**/*"                                   /* Inclut tous les fichiers du dossier src pour la compilation */
  ],
  "exclude": [
    "node_modules",                              /* Ignore les dépendances npm */
    "dist",                                      /* Ignore l'ancien dossier de distribution */
    "tests",                                     /* Les fichiers de tests sont gérés à part par Jest */
    "scripts"                                    /* Le script de benchmark est exécuté directement par tsx */
  ]
}
